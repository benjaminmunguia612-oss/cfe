xion": 1, "cortaron": 1, "reconectar": 1, "suspension": 1, "atrasado": 1, "volver": 1, "paga": 1, "total": 1, "cualquiera": 1, "medio": 1, "despue": 1, "programa": 1, "aplicarse": 1, "cargo": 1, "siguiente": 1, "tiempo": 1, "indicado": 1, "reconectado": 1, "llama": 2, "dano": 1, "contador": 1, "segundo": 1, "marca": 1, "gira": 1, "rapido": 1, "revisar": 1, "aparece": 1, "cree": 1, "mide": 1, "reportalo": 1, "manipule": 1, "sello": 1, "solo": 1, "personal": 1, "intervenirlo": 1, "caido": 1, "riesgo": 1, "electrico": 1, "chispa": 1, "peligro": 1, "suelto": 1, "arbol": 1, "electrocucion": 1, "acerque": 1, "toque": 1, "cualquier": 1, "objeto": 1, "aleja": 1, "mascota": 1, "reporta": 1, "inmediato": 1, "lesionada": 1, "fuego": 1, "primero": 1, "911": 1, "oficina": 2, "sucursal": 1, "cac": 1, "queda": 2, "rede": 1, "telefonica": 1, "nacional": 1, "24": 1, "ubicar": 1, "localizador": 1, "pregunta": 1, "comision": 1, "federal": 1, "electricidad": 1, "centrale": 1, "corporativo": 1, "ubicacion": 1, "reforma": 1, "ciudad": 1, "mexico": 1, "cdmx": 1, "pagina": 1, "av": 1, "paseo": 1, "164": 1, "col": 1, "juarez": 1, "alcaldia": 1, "cuauhtemoc": 1, "c": 1, "p": 1, "06600": 1, "ir": 1, "usa": 1, "ubicado": 1}, "entries": [{"id": "reportar-falla", "titulo": "Reportar una falla o apagón", "puesto": "Atención a Clientes CFE (071)", "audiencia": ["todos"], "categoria": "servicios", "tags": ["apagon", "sin luz", "falla", "se fue la luz", "reportar", "reporte", "transformador", "interrupcion", "bajo voltaje", "cables", "071", "colonia"], "responsable": "", "correo": "", "telefono": "071 (las 24 horas, los 365 días)", "ubicacion": "", "horario": "Las 24 horas, todos los días", "web": "https://www.cfe.mx", "actualizado": "2026-10-17", "pregunta": "¿Cómo reporto un apagón o falla de luz?", "texto": "Antes de reportar, revisa que los interruptores o pastillas de tu casa estén arriba y que los fusibles no estén dañados.\nPuedes reportar la falla llamando al 071, en el sitio web de CFE, en la app CFE Contigo o en un Centro de Atención a Clientes.\nTen a la mano tu número de servicio (parte superior derecha del recibo), tu dirección completa con una referencia y un teléfono de contacto.\nGuarda el número de reporte que te den para dar seguimiento. El restablecimiento por falla no tiene costo."}, {"id": "pagar-recibo", "titulo": "Pagar el recibo de luz", "puesto": "Atención a Clientes CFE", "audiencia": ["todos"], "categoria": "tramites", "tags": ["pagar", "pago", "recibo", "donde pago", "cfematico", "tienda", "banco", "en linea", "app", "tarjeta", "adeudo", "fecha limite"], "responsable": "", "correo": "", "telefono": "", "ubicacion": "", "horario": "", "web": "https://www.cfe.mx", "actualizado": "2026-10-17", "pregunta": "¿Dónde puedo pagar mi recibo de luz?", "texto": "Puedes pagar en línea en el portal de CFE o en la app oficial CFE Contigo con tarjeta bancaria.\nTambién puedes pagar en los cajeros CFEmáticos, en los Centros de Atención a Clientes y en bancos y tiendas autorizadas.\nSi perdiste el recibo, puedes pagar con tu número de servicio de 12 dígitos.\nGuarda tu comprobante: el pago puede tardar en reflejarse según el método y el horario bancario."}, {"id": "consultar-recibo", "titulo": "Consultar o descargar el recibo y la factura", "puesto": "Atención a Clientes CFE", "audiencia": ["todos"], "categoria": "tramites", "tags": ["consultar", "recibo", "descargar", "factura", "cfdi", "numero de servicio", "perdi mi recibo", "saldo", "cuanto debo", "imprimir", "duplicado"], "responsable": "", "correo": "", "telefono": "", "ubicacion": "", "horario": "", "web": "https://www.cfe.mx", "actualizado": "2026-10-17", "pregunta": "¿Cómo consulto o descargo mi recibo?", "texto": "Puedes consultar tu adeudo y descargar tu recibo en el portal de CFE o en la app CFE Contigo registrando tu número de servicio.\nEl número de servicio tiene 12 dígitos y está en la parte superior derecha del recibo.\nSi necesitas factura electrónica, solicítala en el portal de CFE con tu número de servicio y tus datos fiscales."}, {"id": "aclaracion-cobro", "titulo": "Aclaración por cobro excesivo", "puesto": "Atención a Clientes CFE (071)", "audiencia": ["todos"], "categoria": "tramites", "tags": ["aclaracion", "cobro alto", "me llego mucho", "recibo caro", "cobro excesivo", "queja", "revision", "lectura", "inconformidad", "consumo"], "responsable": "", "correo": "", "telefono": "071", "ubicacion": "", "horario": "", "web": "https://www.cfe.mx", "actualizado": "2026-10-17", "pregunta": "Me llegó un recibo muy alto, ¿qué hago?", "texto": "Compara los kilowatts-hora (kWh) del recibo con los de periodos anteriores y revisa si aumentó el uso de aire acondicionado o bombas de agua.\nRevisa que la lectura del medidor coincida con la del recibo y toma una foto del medidor.\nReúne el recibo actual, el anterior y las fotos, y presenta la aclaración al 071, en un Centro de Atención a Clientes o en los canales digitales de CFE.\nSi la lectura no coincide o hubo fallas, solicita una revisión del consumo o del medidor. Actuar pronto ayuda a evitar recargos."}, {"id": "contratar-servicio", "titulo": "Contratar el servicio de luz (nuevo contrato)", "puesto": "Atención a Clientes CFE", "audiencia": ["todos"], "categoria": "tramites", "tags": ["contratar", "contrato", "alta", "casa nueva", "nuevo servicio", "conectar luz", "instalar medidor", "requisitos", "deposito", "factibilidad"], "responsable": "", "correo": "", "telefono": "", "ubicacion": "", "horario": "", "web": "https://www.cfe.mx", "actualizado": "2026-10-17", "pregunta": "¿Qué necesito para contratar la luz?", "texto": "Necesitas identificación oficial vigente, RFC, dirección exacta del inmueble con calles de referencia, teléfono y correo electrónico.\nSi otra persona hace el trámite, lleva carta poder e identificación del representante.\nLa instalación eléctrica debe estar terminada y el poste más cercano a no más de 35 metros en zona urbana o 50 metros en zona rural; si está más lejos se pide un estudio de factibilidad.\nSe solicita en el portal de contratación de CFE o en un Centro de Atención a Clientes. Para casa habitación se cobra un depósito en garantía en el primer recibo."}, {"id": "cambio-titular", "titulo": "Cambio de titular (nombre en el recibo)", "puesto": "Atención a Clientes CFE", "audiencia": ["todos"], "categoria": "tramites", "tags": ["cambio de nombre", "titular", "cambiar nombre", "recibo a mi nombre", "compre casa", "renta", "arrendamiento", "escrituras", "nombre del dueño"], "responsable": "", "correo": "", "telefono": "071", "ubicacion": "", "horario": "", "web": "https://www.cfe.mx", "actualizado": "2026-10-17", "pregunta": "¿Cómo cambio el nombre del titular del recibo?", "texto": "Lleva identificación oficial y un documento que acredite tu relación con el inmueble: escritura, contrato de compraventa o contrato de arrendamiento.\nSegún el caso, pueden pedirte recibo de predial o constancia de domicilio de la autoridad local.\nEl trámite se hace en un Centro de Atención a Clientes o en los canales en línea de CFE; confirma los requisitos de tu caso al 071.\nConserva el folio o comprobante para dar seguimiento."}, {"id": "tarifa-verano-sonora", "titulo": "Tarifa de verano y subsidio en Sonora", "puesto": "CFE · Tarifas domésticas", "audiencia": ["todos"], "categoria": "informacion", "tags": ["tarifa", "subsidio", "verano", "invierno", "1f", "sonora", "hermosillo", "precio", "kwh", "aire acondicionado", "descuento", "temporada"], "responsable": "", "correo": "", "telefono": "", "ubicacion": "", "horario": "", "web": "https://www.cfe.mx", "actualizado": "2026-10-17", "pregunta": "¿Cuándo aplica el subsidio de verano en Sonora?", "texto": "En Hermosillo y gran parte de Sonora aplica la tarifa doméstica 1F, la de mayor subsidio por el clima caluroso.\nEl periodo de verano, con el subsidio más amplio, va del 1 de abril al 31 de octubre.\nDel 1 de noviembre al 31 de marzo (invierno) el consumo subsidiado es mucho menor, por eso el recibo puede subir si mantienes el mismo consumo.\nLos precios por kWh cambian; consulta los vigentes en tu recibo o en el portal de CFE."}, {"id": "corte-reconexion", "titulo": "Corte por falta de pago y reconexión", "puesto": "Atención a Clientes CFE (071)", "audiencia": ["todos"], "categoria": "tramites", "tags": ["corte", "me cortaron la luz", "reconexion", "reconectar", "suspension", "adeudo", "falta de pago", "atrasado", "volver a conectar"], "responsable": "", "correo": "", "telefono": "071", "ubicacion": "", "horario": "", "web": "", "actualizado": "2026-10-17", "pregunta": "Me cortaron la luz por falta de pago, ¿cómo la reconecto?", "texto": "Paga el adeudo total por cualquiera de los medios de pago de CFE y guarda tu comprobante.\nDespués del pago se programa la reconexión; puede aplicarse un cargo por reconexión en tu siguiente recibo.\nSi después del tiempo indicado no se ha reconectado, llama al 071 con tu número de servicio y tu comprobante de pago."}, {"id": "medidor", "titulo": "Medidor de luz: lectura, daño o revisión", "puesto": "Atención a Clientes CFE (071)", "audiencia": ["todos"], "categoria": "servicios", "tags": ["medidor", "lectura", "contador", "medidor dañado", "revision del medidor", "cambiar medidor", "segundo medidor", "no marca", "gira rapido"], "responsable": "", "correo": "", "telefono": "071", "ubicacion": "", "horario": "", "web": "", "actualizado": "2026-10-17", "pregunta": "¿Cómo pido una revisión de mi medidor?", "texto": "Para revisar la lectura, compara los números del medidor con la lectura actual que aparece en tu recibo.\nSi el medidor está dañado, no marca o crees que mide de más, repórtalo al 071 o en un Centro de Atención a Clientes y solicita una revisión.\nNo manipules el medidor ni sus sellos: solo personal de CFE puede intervenirlo."}, {"id": "riesgo-electrico", "titulo": "Cables caídos, postes dañados o riesgo eléctrico", "puesto": "Atención a Clientes CFE (071)", "audiencia": ["todos"], "categoria": "servicios", "tags": ["cable caido", "poste", "chispas", "riesgo", "peligro", "poste dañado", "cables sueltos", "arbol en cables", "electrocucion", "transformador"], "responsable": "", "correo": "", "telefono": "071 (las 24 horas)", "ubicacion": "", "horario": "", "web": "", "actualizado": "2026-10-17", "pregunta": "Hay un cable caído en mi calle, ¿a quién aviso?", "texto": "No te acerques ni toques el cable, el poste o cualquier objeto en contacto con ellos, y aleja a otras personas y mascotas.\nReporta de inmediato al 071 con la dirección exacta y una referencia.\nSi hay personas lesionadas o fuego, llama primero al 911."}, {"id": "centros-atencion", "titulo": "Centros de Atención a Clientes y canales de contacto", "puesto": "Atención a Clientes CFE", "audiencia": ["todos"], "categoria": "informacion", "tags": ["oficina", "sucursal", "centro de atencion", "cac", "donde queda", "atencion a clientes", "hermosillo", "contacto", "telefono", "app", "cfe contigo", "redes"], "responsable": "", "correo": "", "telefono": "071", "ubicacion": "", "horario": "", "web": "https://www.cfe.mx", "actualizado": "2026-10-17", "pregunta": "¿Dónde hay una oficina de CFE?", "texto": "La atención telefónica nacional es el 071, las 24 horas.\nTambién puedes hacer trámites en el portal de CFE, en la app CFE Contigo y en los Centros de Atención a Clientes (CAC).\nPara ubicar el Centro de Atención a Clientes más cercano en Hermosillo, consulta el localizador del portal de CFE o pregunta al 071."}, {"id": "cfe-oficinas-centrales", "titulo": "Comisión Federal de Electricidad (CFE) — Oficinas centrales", "puesto": "Comisión Federal de Electricidad", "audiencia": ["todos"], "categoria": "informacion", "tags": ["direccion", "domicilio", "oficinas centrales", "corporativo", "donde queda", "ubicacion", "reforma", "ciudad de mexico", "cdmx", "contacto", "pagina web", "sitio web"], "responsable": "", "correo": "", "telefono": "071", "ubicacion": "Av. Paseo de la Reforma 164, Col. Juárez, Alcaldía Cuauhtémoc, Ciudad de 